{
  "components": {
    "schemas": {
      "EventDeliveryResponse": {
        "description": "Was the payment event published to the message broker?",
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "event_type": {
            "title": "Event Type",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "status": {
            "$ref": "#/components/schemas/OutboxStatus"
          }
        },
        "required": [
          "id",
          "event_type",
          "status",
          "attempts",
          "created_at",
          "published_at",
          "last_error"
        ],
        "title": "EventDeliveryResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "NotificationEvent": {
        "description": "What a notification tells the user; also the event name in history.",
        "enum": [
          "subscription.expiring_soon",
          "subscription.expired",
          "payment.succeeded",
          "payment.failed"
        ],
        "title": "NotificationEvent",
        "type": "string"
      },
      "NotificationResponse": {
        "properties": {
          "attempts": {
            "title": "Attempts",
            "type": "integer"
          },
          "event_name": {
            "$ref": "#/components/schemas/NotificationEvent"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "scheduled_for": {
            "format": "date-time",
            "title": "Scheduled For",
            "type": "string"
          },
          "sent_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sent At"
          },
          "status": {
            "$ref": "#/components/schemas/NotificationStatus"
          }
        },
        "required": [
          "event_name",
          "scheduled_for",
          "sent_at",
          "status",
          "attempts",
          "last_error"
        ],
        "title": "NotificationResponse",
        "type": "object"
      },
      "NotificationStatus": {
        "enum": [
          "scheduled",
          "enqueued",
          "sent",
          "failed",
          "cancelled"
        ],
        "title": "NotificationStatus",
        "type": "string"
      },
      "OutboxStatus": {
        "enum": [
          "pending",
          "published",
          "dead"
        ],
        "title": "OutboxStatus",
        "type": "string"
      },
      "PaymentResponse": {
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "string"
          },
          "created_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "provider_payment": {
            "title": "Provider Payment",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/PaymentStatus"
          },
          "subscription_id": {
            "title": "Subscription Id",
            "type": "string"
          }
        },
        "required": [
          "id",
          "subscription_id",
          "provider_payment",
          "amount",
          "currency",
          "status",
          "created_at"
        ],
        "title": "PaymentResponse",
        "type": "object"
      },
      "PaymentStatus": {
        "enum": [
          "succeeded",
          "failed"
        ],
        "title": "PaymentStatus",
        "type": "string"
      },
      "PaymentStatusResponse": {
        "properties": {
          "event": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EventDeliveryResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "notification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NotificationResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "payment": {
            "$ref": "#/components/schemas/PaymentResponse"
          }
        },
        "required": [
          "payment",
          "event",
          "notification"
        ],
        "title": "PaymentStatusResponse",
        "type": "object"
      },
      "Problem": {
        "description": "Error body, RFC 9457 (application/problem+json).",
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": true,
                  "type": "object"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errors"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instance"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "default": "about:blank",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "Problem",
        "type": "object"
      },
      "RegisterPaymentRequest": {
        "additionalProperties": false,
        "properties": {
          "amount": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "examples": [
              "9.99"
            ],
            "title": "Amount"
          },
          "currency": {
            "examples": [
              "EUR"
            ],
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "type": "string"
          },
          "provider_payment": {
            "examples": [
              "pi_3PqZ"
            ],
            "maxLength": 128,
            "minLength": 1,
            "title": "Provider Payment",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/PaymentStatus"
          },
          "subscription_id": {
            "examples": [
              "sub-1"
            ],
            "maxLength": 64,
            "minLength": 1,
            "title": "Subscription Id",
            "type": "string"
          }
        },
        "required": [
          "subscription_id",
          "provider_payment",
          "amount",
          "currency",
          "status"
        ],
        "title": "RegisterPaymentRequest",
        "type": "object"
      },
      "RegisterPaymentResponse": {
        "properties": {
          "event_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Event Id"
          },
          "payment": {
            "$ref": "#/components/schemas/PaymentResponse"
          }
        },
        "required": [
          "payment",
          "event_id"
        ],
        "title": "RegisterPaymentResponse",
        "type": "object"
      },
      "SubscriptionResponse": {
        "properties": {
          "day_count": {
            "title": "Day Count",
            "type": "integer"
          },
          "expected_expires_on": {
            "format": "date-time",
            "title": "Expected Expires On",
            "type": "string"
          },
          "notifications": {
            "items": {
              "$ref": "#/components/schemas/NotificationResponse"
            },
            "title": "Notifications",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/SubscriptionStatus"
          },
          "subscription_id": {
            "title": "Subscription Id",
            "type": "string"
          },
          "user_id": {
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "subscription_id",
          "user_id",
          "day_count",
          "expected_expires_on",
          "status",
          "notifications"
        ],
        "title": "SubscriptionResponse",
        "type": "object"
      },
      "SubscriptionStatus": {
        "enum": [
          "active",
          "expired"
        ],
        "title": "SubscriptionStatus",
        "type": "string"
      },
      "UpsertSubscriptionRequest": {
        "additionalProperties": false,
        "properties": {
          "day_count": {
            "examples": [
              30
            ],
            "exclusiveMinimum": 0.0,
            "maximum": 3650.0,
            "title": "Day Count",
            "type": "integer"
          },
          "expected_expires_on": {
            "examples": [
              "2026-11-01T12:00:00Z"
            ],
            "format": "date-time",
            "title": "Expected Expires On",
            "type": "string"
          },
          "user_id": {
            "examples": [
              "user-1"
            ],
            "maxLength": 64,
            "minLength": 1,
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "day_count",
          "expected_expires_on"
        ],
        "title": "UpsertSubscriptionRequest",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Subscriptions, payments with a transactional outbox, notifications.",
    "title": "Subscription billing",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/payments": {
      "get": {
        "operationId": "find_payment_api_v1_payments_get",
        "parameters": [
          {
            "in": "query",
            "name": "provider_payment",
            "required": true,
            "schema": {
              "maxLength": 128,
              "minLength": 1,
              "title": "Provider Payment",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing or invalid X-API-Key"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Database unavailable; retry later"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Find a payment by the provider's payment id",
        "tags": [
          "payments"
        ]
      },
      "post": {
        "description": "The payment and its event are committed in one transaction. Idempotent by `provider_payment`: a retry with the same data returns 200 with the original payment, a retry with different data returns 409.",
        "operationId": "register_payment_api_v1_payments_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterPaymentRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterPaymentResponse"
                }
              }
            },
            "description": "Already registered (replay)"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterPaymentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing or invalid X-API-Key"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Subscription not found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "provider_payment reused with different data"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Database unavailable; retry later"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Record a payment and enqueue an event about its result",
        "tags": [
          "payments"
        ]
      }
    },
    "/api/v1/payments/{payment_id}": {
      "get": {
        "operationId": "get_payment_api_v1_payments__payment_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "payment_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Payment Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentStatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing or invalid X-API-Key"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Database unavailable; retry later"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Payment status and whether its event and notification were delivered",
        "tags": [
          "payments"
        ]
      }
    },
    "/api/v1/subscriptions/{subscription_id}": {
      "get": {
        "operationId": "get_subscription_api_v1_subscriptions__subscription_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "subscription_id",
            "required": true,
            "schema": {
              "examples": [
                "sub-1"
              ],
              "maxLength": 64,
              "minLength": 1,
              "title": "Subscription Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing or invalid X-API-Key"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Database unavailable; retry later"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Subscription state and history of its notifications",
        "tags": [
          "subscriptions"
        ]
      },
      "put": {
        "operationId": "upsert_subscription_api_v1_subscriptions__subscription_id__put",
        "parameters": [
          {
            "in": "path",
            "name": "subscription_id",
            "required": true,
            "schema": {
              "examples": [
                "sub-1"
              ],
              "maxLength": 64,
              "minLength": 1,
              "title": "Subscription Id",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpsertSubscriptionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubscriptionResponse"
                }
              }
            },
            "description": "Subscription created"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Missing or invalid X-API-Key"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Subscription belongs to another user"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Database unavailable; retry later"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Create or update a subscription and schedule its notifications",
        "tags": [
          "subscriptions"
        ]
      }
    },
    "/health/live": {
      "get": {
        "operationId": "live_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Live Health Live Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "The process is up",
        "tags": [
          "health"
        ]
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "ready_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Dependencies are reachable; safe to route traffic here",
        "tags": [
          "health"
        ]
      }
    }
  }
}
