# --- PostgreSQL (used by the postgres container)
POSTGRES_USER=billing
POSTGRES_PASSWORD=billing
POSTGRES_DB=billing

# --- RabbitMQ (used by the rabbitmq and rabbitmq-init containers)
RABBITMQ_USER=billing
RABBITMQ_PASSWORD=billing

# ------------------------------------------------------------
# Application settings (pydantic-settings, APP_ prefix)
# ------------------------------------------------------------
APP_ENV=local

# Connections. Hosts postgres/rabbitmq are compose service names;
# replace them with localhost when running the app from the host.
APP_DATABASE_URL=postgresql+asyncpg://billing:billing@postgres:5432/billing
APP_DATABASE_POOL_SIZE=10
APP_DATABASE_MAX_OVERFLOW=10
APP_RABBITMQ_URL=amqp://billing:billing@rabbitmq:5672/
APP_RABBITMQ_EXCHANGE=billing.events

# API
APP_API_KEY=change-me
APP_LOG_LEVEL=INFO
APP_LOG_JSON=true

# Outbox relay
APP_RELAY_BATCH_SIZE=100
APP_RELAY_POLL_INTERVAL_SECONDS=0.5
APP_RELAY_MAX_ATTEMPTS=10
APP_RELAY_BACKOFF_BASE_SECONDS=1
APP_RELAY_BACKOFF_MAX_SECONDS=300

# Notification scheduler
APP_SCHEDULER_BATCH_SIZE=100
APP_SCHEDULER_POLL_INTERVAL_SECONDS=5
# Reminder offsets relative to expected_expires_on, in days (T-3d, T-1d, T0)
APP_NOTIFICATION_OFFSETS_DAYS=[3,1,0]

# Consumers
APP_CONSUMER_MAX_DELIVERY_ATTEMPTS=5
APP_CONSUMER_PREFETCH_COUNT=20

# Notification sender: log | email (stub)
APP_NOTIFICATION_SENDER=log